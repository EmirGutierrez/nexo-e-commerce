                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "CAÍDO"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "ACTIVO"
                }
              }
            }
          ],
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
