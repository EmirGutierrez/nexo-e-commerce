      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "pg_up{job=\"postgres\"} or (up{job=\"postgres\"} * 0)", "instant": true, "legendFormat": "PostgreSQL", "refId": "A" }],
      "title": "Base de datos PostgreSQL",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
