    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Verifica por HTTPS que el sitio responda con código 200.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "NO DISPONIBLE", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "probe_success{job=\"website\"} or (up{job=\"blackbox-exporter\"} * 0)", "instant": true, "legendFormat": "Sitio web", "refId": "A" }],
      "title": "Página web",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "1 significa que el exportador pudo consultar PostgreSQL; 0 significa que no hay conexión.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "NO DISPONIBLE", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
