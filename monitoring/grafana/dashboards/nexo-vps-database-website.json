          "mappings": [{ "options": { "0": { "text": "NO DISPONIBLE", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
