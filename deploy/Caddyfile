{
	servers {
		max_header_size 64KB
		timeouts {
			read_body 5m
			read_body_idle 30s 8192
			read_header 10s
			idle 2m
		}
		# Actualizar estos rangos desde https://www.cloudflare.com/ips-v4 y /ips-v6.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

(api_security_headers) {
	import security_headers
	header Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	import security_headers
	request_body {
		max_size 2MB
	}
	encode zstd gzip
	reverse_proxy frontend:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

api.{$SITE_DOMAIN} {
	import api_security_headers
	request_body {
		max_size 2MB
	}
	encode zstd gzip
	reverse_proxy backend:8080 {
		header_up X-Forwarded-For {client_ip}
		header_down -Content-Security-Policy
		header_down -Strict-Transport-Security
		header_down -X-Content-Type-Options
		header_down -X-Frame-Options
	}
}
