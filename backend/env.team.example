# Plantilla sin secretos. Copia este archivo a .env.team y agrega los datos
# privados de la base PostgreSQL administrada por el equipo.
DATABASE_URL=jdbc:postgresql://HOST_DE_LA_BASE:5432/NOMBRE_DE_LA_BASE
DATABASE_USERNAME=USUARIO_DE_LA_BASE
DATABASE_PASSWORD=SECRETO_DE_LA_BASE
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX_SIZE=4
SPRING_PROFILES_ACTIVE=team

# Cada integrante ejecuta su API en localhost y comparte los datos de PostgreSQL.
SERVER_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
OPENAPI_ENABLED=true
BOOTSTRAP_ADMIN_ENABLED=false
